# BrightPath CRM — Environment Configuration Template
# Duplicate this file to .env and provide your project keys from Supabase Dashboard -> Project Settings -> API.
# Note: VITE_ variables are bundled into browser code; NEVER paste service_role keys or database passwords here.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
